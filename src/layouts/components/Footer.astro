---
import { SITE_CONFIG } from "../../data/config";
import Navigation from "../../components/Navigation";
import SocialLinks from "../../components/SocialLinks";
import DeveloperCard from "../../components/DeveloperCard";
import TechnologyTags from "../../components/TechnologyTags";

const currentYear = new Date().getFullYear();
---

<footer class="bg-gray-900 text-white mt-auto">
  <div class="container mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <!-- О проекте -->
      <div class="md:col-span-2">
        <h3 class="text-2xl font-bold mb-4 text-blue-400">
          {SITE_CONFIG.name}
        </h3>
        <p class="text-gray-300 mb-4 leading-relaxed">
          {SITE_CONFIG.description}
        </p>
        <SocialLinks variant="footer" />
      </div>

      <!-- Навигация -->
      <div>
        <h4 class="text-lg font-semibold mb-4 text-white">Навигация</h4>
        <Navigation currentPath={Astro.url.pathname} variant="mobile" />
      </div>

      <!-- Разработчик -->
      <div>
        <h4 class="text-lg font-semibold mb-4 text-white">Разработчик</h4>
        <DeveloperCard />
      </div>
    </div>

    <!-- Технологии -->
    <div class="mt-8 pt-8 border-t border-gray-700">
      <h4 class="text-lg font-semibold mb-4 text-white text-center">
        Технологии проекта
      </h4>
      <TechnologyTags />
    </div>

    <!-- Копирайт -->
    <div class="border-t border-gray-700 mt-8 pt-8 text-center">
      <div
        class="flex flex-col md:flex-row justify-between items-center space-y-4 md:space-y-0"
      >
        <p class="text-gray-400">
          &copy; {currentYear}
          {SITE_CONFIG.name}. Все права защищены.
        </p>
        <div class="text-gray-400 text-sm">
          Сделано с ❤️ для сообщества разработчиков
        </div>
      </div>
    </div>
  </div>
</footer>
