---
import type { Challenge } from "../../data/types";
import Card from "../kit/Card";
import {
  DIFFICULTY_COLORS,
  CATEGORY_ICONS,
  CATEGORY_LABELS,
  DIFFICULTY_LABELS,
} from "../../data/constants";

interface Props {
  challenge: Challenge;
}

const { challenge } = Astro.props;

const META_FIELDS = [
  {
    label: "Сложность",
    value: DIFFICULTY_LABELS[challenge.difficulty],
    color: DIFFICULTY_COLORS[challenge.difficulty],
    icon: "🎯",
  },
  {
    label: "Категория",
    value: CATEGORY_LABELS[challenge.category],
    color: "text-gray-700",
    icon: CATEGORY_ICONS[challenge.category],
  },
  {
    label: "Технологии",
    value: challenge.tech.join(", "),
    color: "text-blue-600",
    icon: "⚙️",
  },
];
---

<Card>
  <h3 class="text-lg font-semibold mb-4">ℹ️ Информация о задании</h3>
  <div class="space-y-4">
    {
      META_FIELDS.map(({ label, value, color, icon }) => (
        <div class="flex items-start space-x-3">
          <span class="text-lg mt-0.5 flex-shrink-0">{icon}</span>
          <div class="flex-grow">
            <div class="text-sm text-gray-600 font-medium">{label}</div>
            <div class={`text-sm font-medium ${color}`}>{value}</div>
          </div>
        </div>
      ))
    }
  </div>
</Card>
