---
import type { Challenge } from "../../data/types";
import Button from "../kit/Button";
import ChallengeDifficulty from "./ChallengeDifficulty.astro";
import Breadcrumbs from "../kit/Breadcrumbs";
import ChallengeCategory from "./ChallengeCategory.astro";

interface Props
  extends Omit<Challenge, "resources" | "requirements" | "tech" | "tips"> {}

const { category, description, difficulty, title } = Astro.props;
---

<Breadcrumbs
  items={[
    { label: "Главная", href: "/" },
    { label: "Все задания", href: "/challenges" },
    { label: title },
  ]}
/>

<div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">
  <div>
    <div class="flex items-center space-x-3 mb-2">
      <ChallengeCategory category={category} />
      <ChallengeDifficulty difficulty={difficulty} />
    </div>

    <h1 class="text-3xl md:text-4xl font-bold text-gray-900">
      {title}
    </h1>

    <p class="text-xl text-gray-600 mt-2">{description}</p>
  </div>

  <Button variant="primary" size="lg" disabled title="В разработке"
    >Показать решение</Button
  >
</div>
