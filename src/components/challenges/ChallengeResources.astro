---
import type { Challenge } from "../../data/types";
import Card from "../kit/Card";

interface Props {
  resources: Challenge["resources"];
}

const { resources } = Astro.props;
---

<Card>
  <h3 class="text-lg font-semibold mb-4">📚 Ресурсы</h3>
  <ul class="space-y-2">
    {
      resources.map(({ title, url }) => (
        <li>
          <a
            href={url}
            class="text-blue-600 hover:text-blue-800 text-sm block py-1"
            target="_blank"
          >
            {title}
          </a>
        </li>
      ))
    }
  </ul>
</Card>
