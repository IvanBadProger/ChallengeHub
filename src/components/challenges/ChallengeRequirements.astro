---
import Card from "../ui/Card.astro";

interface Props {
  requirements: string[];
}

const { requirements } = Astro.props;
---

<Card>
  <h2 class="text-2xl font-bold text-gray-900 mb-4">📋 Требования</h2>
  <ul class="space-y-3">
    {
      requirements.map((requirement, index) => (
        <li class="flex items-start space-x-3">
          <span class="bg-blue-100 text-blue-600 rounded-full w-6 h-6 flex items-center justify-center text-sm font-medium mt-0.5 flex-shrink-0">
            {index + 1}
          </span>
          <span class="text-gray-700">{requirement}</span>
        </li>
      ))
    }
  </ul>
</Card>
