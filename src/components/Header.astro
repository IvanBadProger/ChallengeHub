---
import { APP_CONFIG } from "../data/constants";
import { getActiveChallenge, getCompletedChallenges } from "../data/challenges";
---

<header class="bg-white shadow-sm border-b">
  <div class="container mx-auto px-4 py-4">
    <div class="flex justify-between items-center">
      <div>
        <h1 class="text-2xl font-bold text-gray-900">Frontend Challenge</h1>
        <p class="text-gray-600">3-дневные задания для начинающих</p>
      </div>

      <nav class="flex items-center space-x-6">
        <a href="/" class="text-gray-700 hover:text-blue-600 font-medium"
          >Главная</a
        >
        <a
          href="/challenges"
          class="text-gray-700 hover:text-blue-600 font-medium">Все задания</a
        >
        <a href="/about" class="text-gray-700 hover:text-blue-600 font-medium"
          >О проекте</a
        >

        <!-- Статистика -->
        <div class="flex items-center space-x-4 text-sm">
          <span class="bg-blue-100 text-blue-800 px-3 py-1 rounded-full">
            Активно: {
              getActiveChallenge()
                ? "Челендж #" + getActiveChallenge()?.id
                : "Нет"
            }
          </span>
          <span class="bg-green-100 text-green-800 px-3 py-1 rounded-full">
            Завершено: {getCompletedChallenges().length}/{
              APP_CONFIG.TOTAL_CHALLENGES
            }
          </span>
        </div>
      </nav>
    </div>
  </div>
</header>
