---
import { Card } from '@/components/kit';
import clsx from 'clsx';

export interface Props {
  title: string;
  icon?: string;
  numbered?: boolean;
  variant?: 'primary' | 'secondary' | 'accent' | 'neutral';
}

const { title, icon, numbered = true, variant = 'neutral' } = Astro.props;

const variantStyles = {
  primary: {
    iconBg: 'bg-primary-100',
    iconText: 'text-primary-600',
    accent: 'text-primary-600',
  },
  secondary: {
    iconBg: 'bg-secondary-100',
    iconText: 'text-secondary-600',
    accent: 'text-secondary-600',
  },
  accent: {
    iconBg: 'bg-accent-100',
    iconText: 'text-accent-600',
    accent: 'text-accent-600',
  },
  neutral: {
    iconBg: 'bg-neutral-100',
    iconText: 'text-neutral-700',
    accent: 'text-neutral-700',
  },
};

const styles = variantStyles[variant];
---

<Card>
  <h2 class="text-2xl font-bold text-neutral-900 mb-4">
    {
      icon && (
        <span
          class={clsx(
            'rounded-full w-8 h-8 inline-flex items-center justify-center text-sm mr-2',
            styles.iconBg,
            styles.iconText
          )}
        >
          {icon}
        </span>
      )
    }
    {title}
  </h2>

  <ul class={clsx('space-y-3', numbered && 'numbered-list')} data-accent={styles.accent}>
    <slot />
  </ul>
</Card>

<style>
  /* Стили остаются такими же */
  .numbered-list {
    counter-reset: item;
    list-style: none;
    padding-left: 0;
  }

  .numbered-list li {
    counter-increment: item;
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .numbered-list li::before {
    content: counter(item);
    background-color: var(--color-neutral-100);
    color: var(--color-neutral-700);
    border-radius: 50%;
    width: 1.5rem;
    height: 1.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.875rem;
    font-weight: 500;
    flex-shrink: 0;
    margin-top: 0.125rem;
  }

  /* Динамические цвета через data-attribute */
  .numbered-list[data-accent='text-primary-600'] li::before {
    background-color: var(--color-primary-100);
    color: var(--color-primary-600);
  }

  .numbered-list[data-accent='text-secondary-600'] li::before {
    background-color: var(--color-secondary-100);
    color: var(--color-secondary-600);
  }

  .numbered-list[data-accent='text-accent-600'] li::before {
    background-color: var(--color-accent-100);
    color: var(--color-accent-600);
  }

  .numbered-list[data-accent='text-neutral-700'] li::before {
    background-color: var(--color-neutral-100);
    color: var(--color-neutral-700);
  }
</style>
