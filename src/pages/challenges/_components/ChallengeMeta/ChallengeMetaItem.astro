---
interface Props {
  title: string;
  icon?: string;
}

const { title, icon = '🎯' } = Astro.props;
---

<div class="flex items-start space-x-3">
  <span class="text-lg mt-0.5 flex-shrink-0 text-neutral-700">{icon}</span>
  <div class="flex-grow min-w-0">
    <div class="text-sm text-neutral-700 font-medium mb-1">{title}</div>
    <slot />
  </div>
</div>
