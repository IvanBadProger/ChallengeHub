---
import { ArrowIcon } from '@/components/icons';
import { Button, Card } from '@/components/kit';
import { INTERNAL_LINKS } from '@/data/config';

interface Props {
  currentId: number;
  totalChallenges: number;
}

const { currentId, totalChallenges } = Astro.props;
---

<Card className="inline-flex justify-center">
  <h3 class="text-lg font-semibold mb-4 text-neutral-900">🧭 Навигация</h3>
  <div class="space-y-2">
    {
      // fix: когда id поменяются исправить валидацию
      currentId > 1 && (
        <Button
          href={INTERNAL_LINKS.challenge(currentId - 1)}
          variant="outline"
          className="w-full justify-center gap-2"
        >
          <ArrowIcon direction="left" />
          <span class="hidden sm:inline">Предыдущее</span>
        </Button>
      )
    }
    {
      currentId < totalChallenges && (
        <Button
          href={INTERNAL_LINKS.challenge(currentId + 1)}
          variant="outline"
          className="w-full justify-center gap-2"
        >
          <span class="hidden sm:inline">Следующее</span>
          <ArrowIcon direction="right" />
        </Button>
      )
    }
  </div>
</Card>
