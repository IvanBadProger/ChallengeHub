---
import Layout from '@/layouts/Layout.astro';
import { Section, Container, Accordeon } from '@/components/kit';
import { ChallengeHeader, ChallengeMeta, ChallengeNavigation } from './_components';
import { ApiService } from '@/services/ApiService';
import { ContentList } from '@/widgets';
import { INTERNAL_LINKS, SITE_CONFIG } from '@/data/config';

const { id } = Astro.params;

if (!id) {
  throw new Error('Challenge ID is required');
}

const [challenge, meta] = await Promise.all([
  ApiService.fetchChallenge(id),
  ApiService.fetchMeta(),
]);

const title = `${challenge.title} | ${SITE_CONFIG.name}`;

const getDescription = () => {
  if (challenge.description && challenge.description.trim().length > 0) {
    return challenge.description.substring(0, 160);
  }

  return `Задание "${challenge.title}" на платформе ${SITE_CONFIG.name}`;
};

const description = getDescription();

const canonicalUrl = INTERNAL_LINKS.challenge(Number(id));
const robots = 'index, follow';

const hasTips = challenge.tips.length > 0;
const hasResources = challenge.resources.length > 0;
---

<Layout title={title} description={description} canonicalUrl={canonicalUrl} robots={robots}>
  <!-- Заголовок задания -->
  <ChallengeHeader {...challenge} />

  <!-- Контент задания -->
  <Section className="flex justify-stretch items-stretch">
    <Container size="narrow" className="grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- Основной контент -->
      <div class="md:col-span-2 space-y-6">
        <!-- Требования -->
        <ContentList title="Требования" numbered={true}>
          {
            challenge.requirements.map((r) => (
              <li>
                <span class="text-neutral-800">{r}</span>
              </li>
            ))
          }
        </ContentList>

        <!-- Подсказки -->
        {
          hasTips && (
            <Accordeon title="Подсказки">
              <ul>
                {challenge.tips.map((t) => (
                  <li>
                    <span class="text-neutral-800">{t}</span>
                  </li>
                ))}
              </ul>
            </Accordeon>
          )
        }
      </div>

      <!-- Сайдбар -->
      <div class="flex flex-col gap-6">
        <ChallengeMeta challenge={challenge} />

        {
          hasResources && (
            <ContentList title="📚 Ресурсы" numbered={false}>
              {challenge.resources.map(({ title, url }) => (
                <li>
                  <a
                    href={url}
                    class="text-primary-600 hover:text-primary-800 text-sm block py-1"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {title}
                  </a>
                </li>
              ))}
            </ContentList>
          )
        }

        <ChallengeNavigation
          currentId={Number(id)}
          totalChallenges={meta.total}
          class:list={'mx-auto'}
        />
      </div>
    </Container>
  </Section>
</Layout>
