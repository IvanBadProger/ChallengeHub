---
import Layout from "../../layouts/Layout.astro";
import ChallengeHeader from "../../components/challenges/ChallengeHeader.astro";
import ChallengeRequirements from "../../components/challenges/ChallengeRequirements.astro";
import ChallengeTips from "../../components/challenges/ChallengeTips.astro";
import ChallengeMeta from "../../components/challenges/ChallengeMeta.astro";
import ChallengeResources from "../../components/challenges/ChallengeResources.astro";
import ChallengeNavigation from "../../components/challenges/ChallengeNavigation.astro";
import type { Challenge } from "../../data/types";
import type { ChallengesMeta } from "../../pages/api/challenges/meta.json";
import type { ChallengeResponseData } from "../api/challenges/[id].json";

// Получаем ID из параметров
const { id } = Astro.params;

if (!id) {
  throw new Error("Challenge ID is required");
}

// Формируем URL для API
const baseUrl = import.meta.env.DEV
  ? "http://localhost:4321"
  : import.meta.env.SITE || "";
const challengeUrl = `${baseUrl}/api/challenges/${id}.json`;
const metaUrl = `${baseUrl}/api/challenges/meta.json`;

let challenge: Challenge;
let meta: ChallengesMeta;

try {
  // Параллельные запросы
  const [challengeResponse, metaResponse] = await Promise.all([
    fetch(challengeUrl),
    fetch(metaUrl),
  ]);

  const challengeResult: ChallengeResponseData = await challengeResponse.json();
  const metaResult = await metaResponse.json();

  if (!challengeResult.success || !challengeResult.data) {
    throw new Error(challengeResult.error || "Challenge not found");
  }

  if (!metaResult.success) {
    throw new Error("Failed to fetch meta data");
  }

  challenge = challengeResult.data;
  meta = metaResult.data;
} catch (error) {
  console.error("API Error:", error);
  throw new Error("Challenge not found");
}
---

<Layout title={`${challenge.title} - Frontend Challenge`}>
  <div class="max-w-4xl mx-auto space-y-8">
    <ChallengeHeader challenge={challenge} />

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="md:col-span-2 space-y-6">
        <ChallengeRequirements requirements={challenge.requirements} />
        <ChallengeTips tips={challenge.tips} />
      </div>

      <div class="space-y-6">
        <ChallengeMeta challenge={challenge} />
        <ChallengeResources resources={challenge.resources} />
        <ChallengeNavigation
          currentId={Number(id)}
          totalChallenges={meta.total}
        />
      </div>
    </div>
  </div>
</Layout>
