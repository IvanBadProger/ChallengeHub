---
import { ChallengeFilter } from "../../components/challenges/FilteredChallenges";
import Layout from "../../layouts/Layout.astro";

// Получаем параметры из URL
const paramss = Astro.url.searchParams;
const [difficulty, category] = [
  paramss.get("difficulty"),
  paramss.get("category"),
];

// Формируем URL для API с учетом параметров
const baseUrl = import.meta.env.DEV
  ? "http://localhost:4321"
  : import.meta.env.SITE || "";
const params = new URLSearchParams();
if (difficulty) params.append("difficulty", difficulty);
if (category) params.append("category", category);

const challengesUrl = `${baseUrl}/api/challenges.json?${params.toString()}`;

let challengesData;

try {
  const response = await fetch(challengesUrl);
  challengesData = await response.json();

  if (!challengesData.success) {
    throw new Error("Failed to fetch challenges");
  }
} catch (error) {
  console.error("API Error:", error);
}
---

<Layout title="Все задания - ChallengeHub">
  <div class="space-y-8">
    <div>
      <h1 class="text-4xl font-bold text-gray-900 mb-4">Все задания</h1>
      <p class="text-gray-600 text-lg">
        Выберите задание по уровню сложности и категории
      </p>
    </div>

    <ChallengeFilter initialChallenges={challengesData.data} client:load />
  </div>
</Layout>
