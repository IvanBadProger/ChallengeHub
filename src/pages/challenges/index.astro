---
import Layout from "../../layouts/Layout.astro";
import { ChallengeFilter } from "../../components/challenges/FilteredChallenges";
import type { ChallengesResponseData } from "../../pages/api/challenges.json";

const res = await fetch("http://localhost:4321/api/challenges.json?status=all");
const result: ChallengesResponseData = await res.json();
---

<Layout title="Все задания - Frontend Challenge">
  <div class="space-y-8">
    <div>
      <h1 class="text-4xl font-bold text-gray-900 mb-4">Все задания</h1>
      <p class="text-gray-600 text-lg">
        Выберите задание для начала или продолжайте текущий челлендж
      </p>
    </div>

    <ChallengeFilter
      initialChallenges={result.data}
      initialStats={result.stats}
      client:load
    />
  </div>
</Layout>
