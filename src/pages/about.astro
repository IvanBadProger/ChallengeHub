---
import Layout from "../layouts/Layout.astro";
import Card from "../components/kit/Card";
---

<Layout title="О проекте - ChallengeHub">
  <div class="max-w-4xl mx-auto space-y-12">
    <!-- Заголовок -->
    <section class="text-center">
      <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">
        О проекте <span class="text-blue-600">ChallengeHub</span>
      </h1>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">
        Платформа для практического обучения фронтенд-разработке через
        выполнение реальных задач
      </p>
    </section>

    <!-- О проекте -->
    <section>
      <Card class="p-8">
        <h2 class="text-3xl font-bold text-gray-900 mb-6">🎯 Наша миссия</h2>
        <div class="prose prose-lg text-gray-700">
          <p class="mb-4">
            <strong>ChallengeHub</strong> создан для разработчиков, которые хотят
            улучшить свои навыки через практику. Мы верим, что лучший способ научиться
            программированию — это решать реальные задачи.
          </p>
          <p class="mb-4">
            В отличие от традиционных курсов, мы предлагаем готовые проекты
            разной сложности — от простых HTML-страниц до полноценных
            веб-приложений.
          </p>
        </div>
      </Card>
    </section>

    <!-- Преимущества -->
    <section>
      <h2 class="text-3xl font-bold text-gray-900 mb-8 text-center">
        ✨ Почему выбирают нас
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <Card class="p-6 text-center">
          <div class="text-3xl mb-4">🚀</div>
          <h3 class="text-xl font-semibold mb-3">Практический подход</h3>
          <p class="text-gray-600">
            Каждое задание — это реальный проект, который можно добавить в
            портфолио
          </p>
        </Card>

        <Card class="p-6 text-center">
          <div class="text-3xl mb-4">📈</div>
          <h3 class="text-xl font-semibold mb-3">Постепенное усложнение</h3>
          <p class="text-gray-600">
            От простых задач к сложным проектам с понятными требованиями и
            подсказками
          </p>
        </Card>

        <Card class="p-6 text-center">
          <div class="text-3xl mb-4">🎯</div>
          <h3 class="text-xl font-semibold mb-3">Актуальные технологии</h3>
          <p class="text-gray-600">
            Работаем с современным стеком: HTML5, CSS3, JavaScript, API, и
            многое другое
          </p>
        </Card>

        <Card class="p-6 text-center">
          <div class="text-3xl mb-4">🆓</div>
          <h3 class="text-xl font-semibold mb-3">Бесплатный доступ</h3>
          <p class="text-gray-600">
            Все задания доступны бесплатно. Учитесь в своем темпе без
            ограничений
          </p>
        </Card>

        <Card class="p-6 text-center">
          <div class="text-3xl mb-4">💡</div>
          <h3 class="text-xl font-semibold mb-3">Подробные инструкции</h3>
          <p class="text-gray-600">
            Четкие требования, полезные подсказки и дополнительные ресурсы для
            каждого задания
          </p>
        </Card>

        <Card class="p-6 text-center">
          <div class="text-3xl mb-4">👥</div>
          <h3 class="text-xl font-semibold mb-3">Для всех уровней</h3>
          <p class="text-gray-600">
            Подходит как для начинающих, так и для опытных разработчиков
          </p>
        </Card>
      </div>
    </section>

    <!-- Для кого -->
    <section>
      <Card class="p-8">
        <h2 class="text-3xl font-bold text-gray-900 mb-6">
          👨‍💻 Для кого этот проект
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div>
            <h3 class="text-xl font-semibold mb-4 text-green-600">
              Начинающие разработчики
            </h3>
            <ul class="space-y-2 text-gray-700">
              <li>• Хотите создать первое портфолио</li>
              <li>• Ищете практические задачи для закрепления теории</li>
              <li>• Нуждаетесь в четких требованиях и примерах</li>
              <li>• Хотите понять процесс реальной разработки</li>
            </ul>
          </div>
          <div>
            <h3 class="text-xl font-semibold mb-4 text-blue-600">
              Опытные разработчики
            </h3>
            <ul class="space-y-2 text-gray-700">
              <li>• Хотите попрактиковаться с новыми технологиями</li>
              <li>• Ищете идеи для пет-проектов</li>
              <li>• Хотите освежить знания</li>
              <li>• Ищете вызовы для поддержания навыков</li>
            </ul>
          </div>
        </div>
      </Card>
    </section>

    <!-- Технологии -->
    <section>
      <Card class="p-8">
        <h2 class="text-3xl font-bold text-gray-900 mb-6">
          🛠 Технологии в заданиях
        </h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
          <div class="bg-blue-50 p-4 rounded-lg">
            <div class="text-2xl mb-2">🔧</div>
            <div class="font-semibold text-blue-800">HTML5</div>
          </div>
          <div class="bg-purple-50 p-4 rounded-lg">
            <div class="text-2xl mb-2">🎨</div>
            <div class="font-semibold text-purple-700">CSS3</div>
          </div>
          <div class="bg-yellow-50 p-4 rounded-lg">
            <div class="text-2xl mb-2">⚡</div>
            <div class="font-semibold text-yellow-700">JavaScript</div>
          </div>
          <div class="bg-green-50 p-4 rounded-lg">
            <div class="text-2xl mb-2">🌐</div>
            <div class="font-semibold text-green-700">API</div>
          </div>
        </div>
      </Card>
    </section>

    <!-- Призыв к действию -->
    <section class="text-center">
      <Card class="max-w-2xl mx-auto p-8">
        <h2 class="text-2xl font-bold text-gray-900 mb-4">
          Готовы начать обучение?
        </h2>
        <p class="text-gray-600 mb-6">
          Присоединяйтесь к сообществу разработчиков и начните совершенствовать
          свои навыки уже сегодня
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="/challenges"
            class="bg-blue-600 text-white px-6 py-3 rounded-lg hover:bg-blue-800 transition font-medium"
          >
            Начать с первого задания
          </a>
          <a
            href="/"
            class="border border-gray-300 text-gray-700 px-6 py-3 rounded-lg hover:bg-gray-50 transition font-medium"
          >
            На главную
          </a>
        </div>
      </Card>
    </section>
  </div>
</Layout>
