---
import Layout from "../layouts/Layout.astro";
import Card from "../components/kit/Card";
import type { ChallengesResponseData } from "./api/types";
import ChallengeCard from "../components/challenges/ChallengeCard";

const baseUrl = import.meta.env.DEV
	? "http://localhost:4321"
	: import.meta.env.SITE || "";
const metaUrl = `${baseUrl}/api/challenges/meta.json`;
const challengesUrl = `${baseUrl}/api/challenges.json`;

let meta;
let challenges;

try {
	const [challengeResponse, metaResponse] = await Promise.all([
		fetch(challengesUrl),
		fetch(metaUrl),
	]);
	const challengeResult: ChallengesResponseData =
		await challengeResponse.json();
	const metaResult = await metaResponse.json();

	if (!challengeResult.success || !challengeResult.data) {
		throw new Error("Challenges not found");
	}

	if (!metaResult.success) {
		throw new Error("Failed to fetch meta data");
	}

	challenges = challengeResult.data;
	meta = metaResult.data;
} catch (error) {
	console.error("Failed to fetch meta data:", error);
}
---

<Layout title="ChallengeHub | Задания для фронтендеров">
	<div class="space-y-12">
		<!-- Герой секция -->
		<section class="text-center">
			<h1 class="text-4xl md:text-6xl font-bold text-gray-900 mb-6">
				Challenge <span class="text-blue-600">HUB</span>
			</h1>
			<p class="text-xl text-gray-600 max-w-2xl mx-auto mb-8">
				Совершенствуйте навыки фронтенд-разработки практические задания.
			</p>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto">
				<Card className="text-center">
					<div class="text-3xl font-bold text-blue-600 mb-2">
						{meta?.total}
					</div>
					<div class="text-gray-600">Заданий</div>
				</Card>

				<Card className="text-center">
					<div class="text-3xl font-bold text-orange-600 mb-2">
						{meta?.difficulties?.length}
					</div>
					<div class="text-gray-600">уровни сложности</div>
				</Card>

				<Card className="text-center">
					<div class="text-3xl font-bold text-orange-600 mb-2">
						{meta?.categories?.length}
					</div>
					<div class="text-gray-600">категорий</div>
				</Card>
			</div>
		</section>

		<!-- Все челленджи -->
		<section>
			<div class="flex justify-between items-center mb-8">
				<h2 class="text-3xl font-bold text-gray-900">Все задания</h2>
				<a
					href="/challenges"
					class="text-blue-600 hover:text-blue-800 font-medium"
				>
					Смотреть все →
				</a>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
				{
					challenges &&
						challenges.map((challenge) => (
							<ChallengeCard {...challenge} as={"article"} />
						))
				}
			</div>
		</section>

		<!-- Призыв к действию -->
		<section class="text-center">
			<Card className="max-w-2xl mx-auto">
				<h2 class="text-2xl font-bold text-gray-900 mb-4">Готовы начать?</h2>
				<p class="text-gray-600 mb-6">
					Присоединяйтесь к сообществу начинающих разработчиков и
					совершенствуйте навыки через практику.
				</p>
				<a
					href="/challenges"
					class="bg-blue-600 text-white px-8 py-3 rounded-lg hover:bg-blue-800 transition font-medium"
				>
					Начать первый челлендж
				</a>
			</Card>
		</section>
	</div>
</Layout>
